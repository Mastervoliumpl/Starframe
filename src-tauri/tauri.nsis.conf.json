{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "python scripts/check_installer.py"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Starframe",
    "homepage": "https://github.com/Mastervoliumpl/Starframe",
    "shortDescription": "Mod manager for Sanctuary: Shattered Sun",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "target/installer/integration/": "integration/",
      "../LICENSE": "LICENSE.txt",
      "../docs/THIRD_PARTY_NOTICES.md": "notices/THIRD_PARTY_NOTICES.md",
      "../docs/notices/": "notices/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
