{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starframe",
  "version": "0.6.0-dev.1",
  "identifier": "io.github.mastervoliumpl.starframe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starframe",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:1420; img-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMkU3RjhCRDY3RDBGRDQKUldUVUQzM1dpMzh1VXV3TXhRd3FpbUgrK0dBNC9Pa09Fa2duSU5XV0NqZUpMQ0NMR0hKOVE3ZGoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
